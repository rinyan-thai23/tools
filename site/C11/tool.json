      },
      {
        "key": "advertiser",
        "label": "c11.col.advertiser",
        "from": "title"
      },
      {
        "key": "first_shown",
        "label": "c11.col.first_shown",
        "transform": "date"
      },
      {
        "key": "last_shown",
        "label": "c11.col.last_shown",
        "transform": "date"
      }
    ]
  },
  "csv": "C11.csv",
