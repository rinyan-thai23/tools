{
  "id": "C03",
  "endpoint": "serp/google/maps/live/advanced",
  "who": "local_shop",
  "markets": true,
  "slow_search": false,
  "inputs": [
    {
      "id": "keyword",
      "param": "keyword",
      "label": "c03.keyword",
      "multiline": true
    }
  ],
  "count": {
    "param": "depth",
    "options": [
      10,
      20,
      50,
      100
    ],
    "label": "c03.count"
  },
  "result": {
    "items": "result.0.items",
    "where": {
      "type": "maps_search"
    },
    "columns": [
      {
        "key": "rank",
        "label": "c03.col.rank",
        "from": "rank_group"
      },
      {
        "key": "title",
        "label": "c03.col.title"
      },
      {
        "key": "rating",
        "label": "c03.col.rating",
        "from": "rating.value"
      },
      {
        "key": "votes",
        "label": "c03.col.votes",
        "from": "rating.votes_count"
      },
      {
        "key": "address",
        "label": "c03.col.address"
      },
      {
        "key": "phone",
        "label": "c03.col.phone"
      },
      {
        "key": "url",
        "label": "c03.col.url",
        "link": true
      }
    ]
  },
  "csv": "C03.csv",
  "sample_langs": [
    "zh-TW",
    "en",
    "vi",
    "id"
  ],
  "copy": true,
  "multi": {
    "input": "keyword",
    "max": 30,
    "unit_cost": 0.002,
    "parallel": 3,
    "confirm_over": 20
  }
}
