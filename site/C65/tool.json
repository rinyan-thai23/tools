            "message-boards"
          ]
        },
        "columns": [
          {
            "key": "k",
            "label": "c65.col.kind",
            "from": "key",
            "labels": {
              "news": "c65.v.news",
              "blogs": "c65.v.blogs",
              "organization": "c65.v.organization",
