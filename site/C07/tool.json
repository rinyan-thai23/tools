{
  "id": "C07",
  "endpoint": "serp/google/images/live/advanced",
  "who": "kindle_note",
  "markets": true,
  "slow_search": false,
  "inputs": [
    {
      "id": "keyword",
      "param": "keyword",
      "label": "c07.keyword",
      "multiline": true
    }
  ],
  "count": {
    "param": "depth",
    "options": [
      10,
      20,
      50,
      100
    ],
    "label": "c07.count"
  },
  "result": {
    "items": "result.0.items",
    "where": {
      "type": "images_search"
    },
    "columns": [
      {
        "key": "image",
        "label": "c07.col.image",
        "from": "encoded_url",
        "type": "image"
      },
      {
        "key": "title",
        "label": "c07.col.title"
      },
      {
        "key": "url",
        "label": "c07.col.url",
        "link": true
      }
    ]
  },
  "csv": "C07.csv",
  "sample_langs": [
    "zh-TW",
    "en",
    "vi",
    "id"
  ],
  "copy": true,
  "multi": {
    "input": "keyword",
    "max": 30,
    "unit_cost": 0.002,
    "parallel": 3,
    "confirm_over": 20
  }
}
