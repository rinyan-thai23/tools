{
  "id": "C05",
  "endpoint": "serp/google/news/live/advanced",
  "who": "smb_pr",
  "markets": true,
  "slow_search": true,
  "inputs": [
    {
      "id": "keyword",
      "param": "keyword",
      "label": "c05.keyword",
      "multiline": true
    }
  ],
  "count": {
    "param": "depth",
    "options": [
      10,
      20,
      50,
      100
    ],
    "label": "c05.count"
  },
  "result": {
    "items": "result.0.items",
    "where": {
      "type": "news_search"
    },
    "columns": [
      {
        "key": "source",
        "label": "c05.col.source",
        "from": "domain",
        "transform": "strip_www"
      },
      {
        "key": "date",
        "label": "c05.col.date",
        "from": "timestamp",
        "transform": "date"
      },
      {
        "key": "title",
        "label": "c05.col.title"
      },
      {
        "key": "url",
        "label": "c05.col.url",
        "link": true
      }
    ]
  },
  "csv": "C05.csv",
  "sample_langs": [
    "zh-TW",
    "en",
    "vi",
    "id"
  ],
  "copy": true,
  "multi": {
    "input": "keyword",
    "max": 10,
    "unit_cost": 0.002,
    "parallel": 2,
    "confirm_over": 5,
    "cost_count": {
      "base": 0,
      "per": 0.0002
    }
  }
}
