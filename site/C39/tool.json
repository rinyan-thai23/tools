{
  "id": "C39",
  "endpoint": "dataforseo_labs/google/search_intent/live",
  "who": "asp_affiliate",
  "markets": "language",
  "slow_search": false,
  "inputs": [
    {
      "id": "keyword",
      "param": "keywords",
      "label": "c39.keyword",
      "multiline": true,
      "wrap": "lines",
      "max": 5000
    }
  ],
  "language_params": [
    "language_code"
  ],
  "result": {
    "items": "result.0.items",
    "where": {},
    "columns": [
      {
        "key": "keyword",
        "label": "c39.col.keyword"
      },
      {
        "key": "intent",
        "label": "c39.col.intent",
        "from": "keyword_intent.label",
        "labels": {
          "informational": "c39.v.informational",
          "commercial": "c39.v.commercial",
          "transactional": "c39.v.transactional",
          "navigational": "c39.v.navigational"
        }
      }
    ]
  },
  "csv": "C39.csv",
  "sample_langs": [
    "zh-TW",
    "en"
  ],
  "copy": true,
  "chunk": {
    "param": "keywords",
    "input": "keyword",
    "size": 1000,
    "max": 5000,
    "unit_cost": 0.13,
    "merge_items": true,
    "base": 0.01,
    "per_item": 0.00012
  }
}
