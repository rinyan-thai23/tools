{
  "id": "C23",
  "endpoint": "ai_optimization/ai_keyword_data/keywords_search_volume/live",
  "who": "kindle_note",
  "markets": true,
  "slow_search": false,
  "inputs": [
    {
      "id": "keyword",
      "param": "keywords",
      "label": "c23.keyword",
      "wrap": "lines",
      "multiline": true,
      "max": 2000
    }
  ],
  "result": {
    "items": "result.0.items",
    "where": {},
    "columns": [
      {
        "key": "keyword",
        "label": "c23.col.keyword",
        "from": "__parent.keyword"
      },
      {
        "key": "ym",
        "label": "c23.col.ym",
        "join": [
          "year",
          "month"
        ],
        "sep": "-"
      },
      {
        "key": "volume",
        "label": "c23.col.volume",
        "from": "ai_search_volume"
      }
    ],
    "flatten": [
      "ai_monthly_searches"
    ]
  },
  "csv": "C23.csv",
  "sample_langs": [
    "zh-TW",
    "en",
    "vi"
  ],
  "copy": true,
  "chunk": {
    "param": "keywords",
    "input": "keyword",
    "size": 1000,
    "max": 2000,
    "unit_cost": 0.13,
    "merge_items": true,
    "base": 0.01,
    "per_item": 0.00012
  }
}
