{
  "id": "C41",
  "endpoint": "dataforseo_labs/google/historical_keyword_data/live",
  "who": "seller",
  "markets": true,
  "slow_search": false,
  "inputs": [
    {
      "id": "keyword",
      "param": "keywords",
      "label": "c41.keyword",
      "wrap": "lines",
      "multiline": true,
      "max": 500
    }
  ],
  "result": {
    "items": "result.0.items",
    "where": {},
    "columns": [
      {
        "key": "keyword",
        "label": "c41.col.keyword",
        "from": "__parent.keyword"
      },
      {
        "key": "ym",
        "label": "c41.col.ym",
        "join": [
          "year",
          "month"
        ],
        "sep": "-"
      },
      {
        "key": "volume",
        "label": "c41.col.volume",
        "from": "keyword_info.monthly_searches.0.search_volume"
      }
    ],
    "chart": {
      "x": "ym",
      "y": [
        "volume"
      ],
      "reverse": true,
      "single": "keyword"
    },
    "flatten": [
      "history"
    ]
  },
  "csv": "C41.csv",
  "sample_langs": [
    "zh-TW",
    "en"
  ],
  "copy": true,
  "chunk": {
    "param": "keywords",
    "input": "keyword",
    "size": 500,
    "max": 500,
    "unit_cost": 0.08,
    "merge_items": true,
    "base": 0.01,
    "per_item": 0.00012
  }
}
